{
  "name": "Werkbank",
  "short_name": "Werkbank",
  "description": "Kostprijscalculator en mini-ERP voor staalbouw en metaalbewerking",
  "start_url": "werkbank-v2.html",
  "display": "standalone",
  "background_color": "#161C24",
  "theme_color": "#161C24",
  "icons": [
    { "src": "brand/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any maskable" },
    { "src": "brand/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any maskable" }
  ],
  "file_handlers": [
    {
      "action": "werkbank-v2.html",
      "accept": { "model/step": [".step", ".stp"], "application/step": [".step", ".stp"] }
    }
  ],
  "share_target": {
    "action": "share-target.html",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "files": [
        { "name": "gedeeld", "accept": ["model/step", "application/step", ".step", ".stp", "image/*"] }
      ]
    }
  }
}
